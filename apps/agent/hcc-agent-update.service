[Unit]
Description=HCC agent update helper (oneshot)
Documentation=https://github.com/HinesAI/home-command-center
DefaultDependencies=no
After=network.target

[Service]
Type=oneshot
ExecStart=/opt/hcc-agent/apply-update.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
