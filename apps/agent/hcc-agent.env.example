# Required: point to your current HCC core base URL (no trailing slash)
# Example:
# HCC_CORE_BASE_URL=http://hcc.example.local
HCC_CORE_BASE_URL=

# Optional: use explicit full heartbeat endpoint instead of base URL
# HCC_CORE_HEARTBEAT_URL=http://hcc.example.local/api/v1/agent/heartbeat

# Required per-host identity (must be unique in fleet)
HCC_AGENT_NODE_ID=
HCC_AGENT_ID=

# Optional tuning
HCC_AGENT_INTERVAL_SECONDS=120
HCC_STORAGE_PATHS=/,/srv,/mnt/storage,/media/storage
HCC_SERVICES=docker,ssh,ufw
HCC_CONTAINERS=nextcloud,jellyfin,mariadb,postgres,redis,nginx,traefik,caddy

