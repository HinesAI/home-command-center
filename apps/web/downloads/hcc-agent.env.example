# Agent identity, service accounts, and future update/deploy paths.
# See docs/AGENT-IDENTITY.md for AD setup guidance.

# HCC Core endpoint
HCC_CORE_BASE_URL=http://hcc.example.local

# Agent identity
HCC_AGENT_NODE_ID=win-dc-01
HCC_AGENT_ID=agent-win-dc-01
HCC_AGENT_VERSION=1.0.4

# Optional: dedicated service account (recommended over SYSTEM for production)
# Use gMSA form with trailing $ for domain-managed service accounts.
# HCC_SERVICE_ACCOUNT=EXAMPLE\svc-hcc-agent$

# Optional: shared secret or token presented to core on heartbeat (future mTLS replaces this)
# HCC_AGENT_TOKEN=

# Timing
HCC_AGENT_INTERVAL_SECONDS=120

# Windows services to monitor
HCC_SERVICES=NTDS,DNS,DHCP,KDC,Netlogon,W32Time,WinRM,W3SVC,Spooler

# Local volumes to report (drive letters without colon)
HCC_STORAGE_DRIVES=C,D
