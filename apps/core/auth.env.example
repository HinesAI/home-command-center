# HCC Core authentication (copy values into docker-compose or export before start)
HCC_AUTH_ENABLED=true
HCC_AUTH_SECRET=replace-with-long-random-secret
HCC_WEB_ORIGIN=http://hcc.example.local
HCC_SESSION_TTL_SECONDS=43200

# Active Directory (EXAMPLE)
HCC_LDAP_SERVER=ldap://192.168.1.11
HCC_LDAP_BASE_DN=DC=example,DC=local
HCC_LDAP_DOMAIN=example.local
HCC_LDAP_NETBIOS=EXAMPLE

# Local break-glass admin (works even if AD/LDAP is unavailable)
HCC_LOCAL_ADMIN_USER=hccadmin
HCC_LOCAL_ADMIN_PASSWORD=replace-with-strong-local-password
