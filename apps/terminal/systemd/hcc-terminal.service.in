[Unit]
Description=HCC Terminal console dashboard
Documentation=https://github.com/HinesAI/HCCv2/tree/main/apps/terminal
After=local-fs.target multi-user.target network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment=TERM=linux
Environment=HCC_SYSTEMD=1
Environment=HCC_TERMINAL_APP_ROOT=@INSTALL_DIR@
Environment=HCC_TERMINAL_CONFIG_DIR=@CONFIG_DIR@
Environment=HCC_TERMINAL_STATE_DIR=@STATE_DIR@
EnvironmentFile=-@CONFIG_DIR@/hcc-terminal.env
ExecStartPre=@INSTALL_DIR@/bin/hcc-terminal-preflight
ExecStart=@INSTALL_DIR@/bin/hcc-terminal
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
KillMode=control-group
TimeoutStartSec=90
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
