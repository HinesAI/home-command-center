# HCC Terminal runtime settings.
# The installer copies this to /etc/hcc-terminal/hcc-terminal.env.

TZ=America/Chicago
HCC_REFRESH_SEC=120
HCC_TTY_DEV=/dev/tty1
HCC_COLS=128
HCC_ROWS=48

# Optional product branding override (default: Home Command Center).
# HCC_PRODUCT_NAME=Hines Command Center
HCC_STARTUP_ANIM=1
HCC_STARTUP_STYLE=color
HCC_STARTUP_SOUND_ENABLED=1
# HCC_STARTUP_SOUND_DEVICE=plughw:PCH,0
# HCC_STARTUP_SOUND_VOLUME=100%

# Standalone integration endpoints. These will become optional once the
# terminal client consumes normalized state from HCC Core.
HCC_PVE_API_IP=127.0.0.1
HCC_FRIGATE_URL=http://127.0.0.1:5000
HCC_HA_URL=http://127.0.0.1:8123
HCC_DNS_TEST_HOST=example.com
HCC_OLLAMA_URL=http://127.0.0.1:11434
HCC_RAGFLOW_URL=http://127.0.0.1:9380
# HCC_RAGFLOW_API_TOKEN_FILE=/path/to/ragflow-api-token

# Future Core-connected mode.
# HCC_CORE_URL=http://127.0.0.1:18080
# HCC_CORE_TOKEN=
