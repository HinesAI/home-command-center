# Optional Proxmox API token for CPU, memory, and workload details.
# Copy to hcc-proxmox.env and set mode 600.
#
# Cluster token:
# HCC_PVE_TOKEN='root@pam!hcc-terminal=TOKEN-SECRET'
#
# Optional per-node token; replace pve1 with the node name:
# HCC_PVE_TOKEN_pve1='root@pam!hcc-terminal=TOKEN-SECRET'
