#!/usr/bin/env bash
# Start or restart Home Command Center on the physical monitor.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="${HCC_TERMINAL_APP_ROOT:-$(cd -- "$SCRIPT_DIR/.." && pwd)}"
CONFIG_DIR="${HCC_TERMINAL_CONFIG_DIR:-$APP_ROOT/config}"
# shellcheck source=/dev/null
[[ -f "$CONFIG_DIR/hcc-terminal.env" ]] && source "$CONFIG_DIR/hcc-terminal.env"
STATE_DIR="${HCC_TERMINAL_STATE_DIR:-$APP_ROOT/var}"
mkdir -p "$STATE_DIR"
PIDFILE="$STATE_DIR/hcc-dashboard.pid"
LOCKFILE="$STATE_DIR/hcc-dashboard.lock"
LOG="$STATE_DIR/hcc-dashboard.log"
SCRIPT="$SCRIPT_DIR/hcc-terminal"

if command -v systemctl >/dev/null 2>&1 \
	&& systemctl list-unit-files hcc-terminal.service >/dev/null 2>&1; then
	if [[ "$(id -u)" -eq 0 ]]; then
		systemctl restart hcc-terminal
	else
		sudo systemctl restart hcc-terminal
	fi
	echo "HCC Terminal restarted via systemd (tty1)"
	exit 0
fi

# Fallback when systemd unit is not installed.
if [[ -f "$PIDFILE" ]]; then
	old_pid="$(cat "$PIDFILE" 2>/dev/null || true)"
	if [[ -n "$old_pid" ]] && kill -0 "$old_pid" 2>/dev/null; then
		kill "$old_pid" 2>/dev/null || true
		sleep 1
		kill -9 "$old_pid" 2>/dev/null || true
	fi
fi
pkill -f "$SCRIPT" 2>/dev/null || true
sleep 1

exec 9>"$LOCKFILE"
if ! flock -n 9; then
	echo "Dashboard already running (lock held)"
	exit 0
fi

"$SCRIPT_DIR/hcc-collect-status"

export TERM=linux
export LANG=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8
export HCC_TERMINAL_APP_ROOT="$APP_ROOT"
export HCC_TERMINAL_CONFIG_DIR="$CONFIG_DIR"
export HCC_TERMINAL_STATE_DIR="$STATE_DIR"
export HCC_COLS="${HCC_COLS:-128}"
export HCC_ROWS="${HCC_ROWS:-48}"
setsid bash -c "exec '$SCRIPT'" </dev/null >>"$LOG" 2>&1 &
echo $! >"$PIDFILE"
echo "Dashboard started on tty1 (pid $(cat "$PIDFILE"))"
