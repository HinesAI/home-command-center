{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hccv2.local/schemas/service-definition.schema.json",
  "title": "ServiceDefinition",
  "type": "object",
  "required": ["id", "displayName", "serviceType", "statusSource", "actions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-\\.]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 2
    },
    "serviceType": {
      "type": "string",
      "enum": ["systemd", "windows_service", "docker_container", "http_check", "custom"]
    },
    "statusSource": {
      "type": "object",
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["service_manager", "docker", "http", "script"]
        },
        "target": {
          "type": "string"
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600,
          "default": 15
        }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "mode", "allowRoles"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["start", "stop", "restart", "custom"]
          },
          "label": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": ["managed", "script"]
          },
          "command": {
            "type": "string"
          },
          "allowRoles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "requiresReason": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

