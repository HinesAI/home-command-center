# HCC production runtime configuration.
# The installer replaces values wrapped in double underscores.

# Product branding (default: Home Command Center)
# HCC_PRODUCT_NAME=Home Command Center
# HCC_PRODUCT_SHORT_NAME=HCC

HCC_AUTH_ENABLED=true
HCC_AUTH_SECRET=__HCC_AUTH_SECRET__
HCC_SESSION_TTL_SECONDS=43200
HCC_AUTH_COOKIE_SECURE=false
HCC_WEB_ORIGIN=http://__HCC_HOSTNAME__
HCC_WEB_BASE_URL=http://__HCC_HOSTNAME__/downloads

HCC_LOCAL_ADMIN_USER=hccadmin
HCC_LOCAL_ADMIN_PASSWORD=__HCC_LOCAL_ADMIN_PASSWORD__

# Active Directory / LDAP
HCC_LDAP_SERVER=ldap://192.168.1.11
HCC_LDAP_BASE_DN=DC=example,DC=local
HCC_LDAP_DOMAIN=example.local
HCC_LDAP_NETBIOS=EXAMPLE
HCC_LDAP_USE_TLS=false
HCC_LDAP_BIND_USER=
HCC_LDAP_BIND_PASSWORD=

# Home Assistant
HCC_HA_URL=http://192.168.1.20:8123
HCC_HA_TOKEN=
HCC_HA_CLIMATE_ENTITIES=
HCC_CLIMATE_REFRESH_SECONDS=30

# Frigate
HCC_FRIGATE_URL=http://192.168.1.30:5000
HCC_INTEGRATION_TIMEOUT=5

# Open-Meteo
HCC_WEATHER_LAT=33.9090855
HCC_WEATHER_LON=-87.3901102
HCC_WEATHER_LABEL=919 Old Zion Rd - Nauvoo, AL
HCC_WEATHER_TIMEZONE=America/Chicago
HCC_WEATHER_CACHE_SECONDS=900

# UniFi Network
HCC_UNIFI_URL=https://192.168.1.1
HCC_UNIFI_SITE=default
HCC_UNIFI_API_KEY=
HCC_UNIFI_VERIFY_SSL=false
HCC_NETWORK_CACHE_SECONDS=60

# Core behavior
HCC_REFRESH_SECONDS=120
HCC_HEARTBEAT_TTL_SECONDS=360
HCC_NODE_HISTORY_LIMIT=240
