# Per-service integration source (default: legacy — current behavior unchanged)
#   legacy          API uses integrations.py only
#   collector       API prefers collector snapshot, falls back to legacy
#   collector-only  API uses collector snapshot only (legacy API pulls disabled)
#
# HCC_INTEGRATION_SOURCE=legacy
# HCC_SOURCE_WEATHER=legacy
# HCC_SOURCE_NETWORK=legacy
# HCC_SOURCE_SECURITY=legacy
# HCC_SOURCE_CLIMATE=legacy
#
# Disable legacy API pulls for a service (used after greenlight):
# HCC_LEGACY_WEATHER=false
#
# Optional debug field on integration responses:
# HCC_INTEGRATION_SOURCE_DEBUG=false

# Runtime settings overlay (managed by Admin GUI / scripts/hcc-settings)
# HCC_SETTINGS_FILE=/app/data/hcc-settings.env
