[Unit]
Description=Hines Command Center console dashboard (tty1)
Documentation=file:///Backup_Pool/scripts/hines-command-center-dashboard.sh
DefaultDependencies=no
After=local-fs.target
After=Backup_Pool.mount
After=hcc-early-console.service
After=quadro600-console.service
Wants=quadro600-console.service
# Start as soon as Backup_Pool scripts are mounted — do not wait for multi-user.
# Boot ASCII sequence waits on real service readiness itself.
RequiresMountsFor=/Backup_Pool/scripts
Conflicts=getty@tty1.service hcc-early-console.service
Before=getty@tty1.service

[Service]
Type=simple
Environment=TERM=linux
Environment=LANG=en_US.UTF-8
Environment=LC_CTYPE=en_US.UTF-8
Environment=TZ=America/Chicago
Environment=HCC_SYSTEMD=1
Environment=HCC_REFRESH_SEC=120
Environment=HCC_STARTUP_ANIM=1
Environment=HCC_STARTUP_STYLE=appliance
Environment=HCC_STARTUP_SOUND_ENABLED=1
Environment=HCC_STARTUP_SOUND_FILE=/Backup_Pool/scripts/startupdash.wav
Environment=HCC_BOOT_STEP_TIMEOUT=90
# Quiet halt screen: hold/repaint briefly, then leave last frame (no tty wipe).
Environment=HCC_HALT_HOLD_SEC=12
Environment=HCC_HALT_REPAINT_SEC=2
ExecStartPre=/Backup_Pool/scripts/hcc-dashboard-preflight.sh
ExecStartPre=/Backup_Pool/scripts/hcc-tty-utf8.sh
ExecStart=/Backup_Pool/scripts/hines-command-center-dashboard.sh
ExecStop=/Backup_Pool/scripts/hcc-appliance-halt.sh
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
# Reset on start so we cleanly take over from early-console; do not hang up/wipe
# on stop so the halt/reboot screen remains visible.
TTYReset=yes
TTYVHangup=no
KillMode=mixed
TimeoutStartSec=120
# Allow circular unload narrative (Stopping/Stopped per service) to finish.
TimeoutStopSec=90
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
WantedBy=Backup_Pool.mount
