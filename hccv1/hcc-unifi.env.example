# Dream Machine / UniFi local admin (copy to hcc-unifi.env, chmod 600)
# Enables VLAN names/subnets, WAN and UniFi speedtest on the NETWORK panel.
#
#   cp hcc-unifi.env.example hcc-unifi.env
#   chmod 600 hcc-unifi.env
#
HCC_UNIFI_HOST='192.168.4.1'
HCC_UNIFI_USER='your-local-admin'
HCC_UNIFI_PASS='your-password'
HCC_UNIFI_SITE='default'
