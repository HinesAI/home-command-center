# HCC daily email report settings
# Copy to: /Backup_Pool/scripts/hcc-email.env
# chmod 600 /Backup_Pool/scripts/hcc-email.env

# Comma-separated recipients
HCC_EMAIL_TO="you@example.com"

# Sender envelope/from address
HCC_EMAIL_FROM="hcc@web-flip.local"

# SMTP endpoint (smtp://host:587 for STARTTLS, smtps://host:465 for implicit TLS)
HCC_SMTP_URL="smtp://smtp.example.com:587"

# SMTP auth (optional if relay allows unauthenticated local send)
HCC_SMTP_USER="smtp-user"
HCC_SMTP_PASS="smtp-password"

# 1 = require STARTTLS (default), 0 = do not force TLS
HCC_SMTP_STARTTLS=1

# Optional subject prefix
HCC_EMAIL_SUBJECT_PREFIX="HCC Daily Report"
