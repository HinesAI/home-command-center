# Optional Proxmox API token for richer dashboard stats (CPU/RAM/VM counts).
# Copy to hcc-proxmox.env and chmod 600.
#
# CLUSTER (recommended): create ONE token on any node — it replicates to the cluster.
#   Datacenter -> Permissions -> API Tokens -> Add
#   Path: /   Role: PVEAuditor (version only) OR add Sys.Audit + VM.Audit for CPU/RAM/VMs
#   Then set a single shared token here:
#
# HCC_PVE_TOKEN='root@pam!hcc-dashboard=YOUR-UUID-SECRET'
#
# Per-node overrides (optional, only if you need different tokens):
# HCC_PVE_TOKEN_bigbear1='...'
# HCC_PVE_TOKEN_bigbear3='...'
# HCC_PVE_TOKEN_bigbear4='...'
